# OpenBound Docker Environment Configuration
# Copy this file to .env and update the values for your environment

# Database Configuration
DB_PASSWORD=YourStrong@Passw0rd
MSSQL_PID=Developer

# Server Ports (Host:Container mapping)
AVATAR_API_PORT=5000
LOGIN_SERVER_PORT=8022
LOBBY_SERVER_PORT=8023
GAME_SERVER_PORT=8024
DATABASE_PORT=1433

# ASP.NET Core Configuration
ASPNETCORE_ENVIRONMENT=Production

# Optional: If using external database, uncomment and configure
# DB_HOST=your-database-server.com
# DB_NAME=OpenBound
# DB_USER=sa
